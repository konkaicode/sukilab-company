# GitHub API 用設定（Vercel デプロイ時のみ必須。ローカル server.js は不要）
#
# 1. GitHub で PAT を作成: https://github.com/settings/tokens
#    - Fine-grained personal access token を推奨
#    - Repository access: sukilab-company のみ
#    - Permissions: Contents = Read and write
#
# 2. Vercel ダッシュボードの Project Settings → Environment Variables に追加
#    （ローカルで vercel dev を使う場合は .env.local に同じ内容をコピー）

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=konkaicode
GITHUB_REPO=sukilab-company
GITHUB_BRANCH=main
TODOS_PATH=.company/secretary/todos
